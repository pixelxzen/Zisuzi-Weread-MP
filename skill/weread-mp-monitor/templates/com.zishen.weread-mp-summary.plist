<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zishen.weread-mp-summary</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/__USER__/.weread-monitor &amp;&amp; /usr/bin/python3 summary.py &gt;&gt; logs/summary.log 2&gt;&amp;1</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/__USER__/.weread-monitor/logs/summary.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/__USER__/.weread-monitor/logs/summary.err.log</string>
</dict>
</plist>
