{
  "name": "zisuzi-weread-mp",
  "version": "4.6.1",
  "description": "Archive WeChat Official Account articles from your WeRead shelf as local Markdown notes.",
  "main": "main.js",
  "type": "module",
  "author": "紫苏子ACG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelxzen/Zisuzi-Weread-MP.git"
  },
